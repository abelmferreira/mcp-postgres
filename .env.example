# ===========================================
# MCP PostgreSQL - Environment Variables
# ===========================================
#
# Every variable can be given in three ways (highest precedence first):
#   1. the "env" block of the MCP client config (.mcp.json) or the shell;
#   2. a dotenv file pointed to by ENV_FILE (see below);
#   3. `npm start`, which reads ./.env (development only).

# -------------------------------------------
# ENV_FILE (OPTIONAL, set it in the MCP client "env" block, not here)
# -------------------------------------------
# Path of a dotenv file with the variables below. Variables already present in
# the environment win over the file. ~ is expanded; relative paths are resolved
# against the working directory. A missing/unreadable file aborts the start.
#   "env": { "ENV_FILE": "/path/to/project/.env" }

# -------------------------------------------
# PostgreSQL Connection
# -------------------------------------------
# You can configure the connection in TWO ways:
#
# OPTION 1: Connection URL (recommended for simplicity)
# OPTION 2: Individual parameters (for more control)
#
# If SQL_CONNECTION_URL is set, it takes precedence over
# individual parameters (SQL_SERVER, SQL_DATABASE, etc.)

# -------------------------------------------
# OPTION 1: Connection URL
# -------------------------------------------
# Format: postgres://user:password@host:port/database?options
#
# Supported query parameters:
#   - ssl=true|false|disable
#
# Examples:
#   SQL_CONNECTION_URL=postgres://postgres:Password123@localhost:5432/MyDatabase
#   SQL_CONNECTION_URL=postgres://postgres:Password123@localhost:5432/MyDatabase?ssl=false
#   SQL_CONNECTION_URL=postgresql://user:pass@192.168.1.100:5432/ProductionDB?ssl=true
#
# SQL_CONNECTION_URL=postgres://postgres:YourStrongPassword123!@localhost:5432/MyDatabase?ssl=true

# -------------------------------------------
# OPTION 2: Individual Parameters
# -------------------------------------------

# PostgreSQL host (IP address or hostname)
SQL_SERVER=localhost

# Database name
SQL_DATABASE=MyDatabase

# PostgreSQL authentication
SQL_USER=postgres
SQL_PASSWORD=YourStrongPassword123!

# -------------------------------------------
# PostgreSQL Connection (OPTIONAL)
# -------------------------------------------
# These settings apply to both connection methods.
# Note: If using URL, port/encrypt/trust are parsed from the URL.

# PostgreSQL port (default: 5432)
SQL_PORT=5432

# Use SSL connection (default: false). The certificate is not verified.
# Through the SSH tunnel the TLS servername (SNI) is still SQL_SERVER.
SQL_SSL=false

# -------------------------------------------
# Operation Mode (REQUIRED)
# -------------------------------------------

# READONLY mode controls what operations are allowed:
#   true  = Read-only mode (SELECT/WITH/EXPLAIN only). Enforced by the query
#           validator AND by the database: sessions are opened with
#           default_transaction_read_only=on and every query runs inside a
#           READ ONLY transaction (see README "How READONLY=true is enforced").
#   false = Full access mode (SELECT, INSERT, UPDATE, DELETE)
#
# The server will NOT start if this variable is not set.
READONLY=true

# -------------------------------------------
# Performance Settings (OPTIONAL)
# -------------------------------------------

# Query timeout in milliseconds (default: 30000, max: 120000).
# Also used for idle_in_transaction_session_timeout (this value + 5s).
QUERY_TIMEOUT=30000

# Hard cap for rows returned per query (default: 1000, max: 5000).
# The limit is applied on the server; results report truncated=true when
# there were more rows.
MAX_ROWS=1000

# Connection pool minimum connections (default: 2)
POOL_MIN=2

# Connection pool maximum connections (default: 10)
POOL_MAX=10

# -------------------------------------------
# Logging (OPTIONAL)
# -------------------------------------------

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# -------------------------------------------
# SSH tunnel (OPTIONAL)
# -------------------------------------------
# When SSH_HOST is set the server opens the tunnel itself (no manual `ssh -L`):
# SQL_SERVER:SQL_PORT is then the database address AS SEEN FROM THE SSH HOST.
# SSH_USER, SSH_KEY_PATH and SSH_HOST_FINGERPRINT become mandatory.
# SSH_HOST=bastion.example.com
# SSH_PORT=22
# SSH_USER=tunnel
# Private key path on the machine running the server (~ is expanded, prefer
# absolute paths).
# SSH_KEY_PATH=~/.ssh/mcp_tunnel_key
# Only for encrypted keys
# SSH_KEY_PASSPHRASE=
# Pinned host key fingerprint(s), comma separated (ssh-keygen -lf <host key .pub>)
# SSH_HOST_FINGERPRINT=SHA256:xxxxxxxx,SHA256:yyyyyyyy
